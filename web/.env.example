# PostgreSQL runtime connection (use the provider's pooled endpoint on Vercel).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Separate primary/fallback keys keep the two AI workloads isolated.
GROQ_API_KEY_CONSULTANT=
GROQ_API_KEY_CONSULTANT_FALLBACK=
GROQ_API_KEY_ASSISTANT=
GROQ_API_KEY_ASSISTANT_FALLBACK=

# Required before enabling self-service password recovery.
RESEND_API_KEY=
# Replace the onboarding address with a sender on a verified domain.
RESEND_FROM=Continuum <no-reply@example.com>
